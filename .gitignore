# Init marker (local runtime)
.csesh-init

# User data (generated at runtime)
cache.json
metadata.json
trash/
trash-manifest.json

# Local config overrides (config.default.json is tracked, not this one)
config.json

# Content drafts — not for the repo (files only, dirs allowed so docs/agents/ is reachable)
docs/*
!docs/agents/
!docs/adr/

# Local Claude project worktrees/sessions (never commit)
.claude/
src-tauri/

# Secrets
.env
.env.*

# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
.claude/worktrees/
